PORT=5000
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
HENRIKDEV_API_KEY=your_key_here

DISCORD_WEBHOOK_URL=

DISCORD_TEAM_WEBHOOK_URL=

# "Sign in with Google" — see console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Used to build links in emails (password reset, etc) — your frontend's dev/prod URL
FRONTEND_URL=http://localhost:5173

# SMTP for sending emails (password reset). Works with any provider that
# gives you SMTP credentials — Gmail (app password), Resend, SendGrid,
# Mailgun, Postmark, etc. Example values are for Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ClutchCircuit <your-address@gmail.com>"
