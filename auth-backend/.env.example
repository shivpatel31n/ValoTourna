PORT=5000
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
HENRIKDEV_API_KEY=your_key_here

# Get a free key by joining the HenrikDev Discord: https://discord.gg/X3GaVkX2YN
# then generating one at https://api.henrikdev.xyz/dashboard/

# Optional: posts a message to a Discord channel whenever a team requests a
# scrim. In your Discord server: Server Settings -> Integrations -> Webhooks
# -> New Webhook, pick a channel (e.g. #scrim-requests), copy the URL below.
# Leave blank to disable this — nothing else depends on it.
DISCORD_WEBHOOK_URL=
